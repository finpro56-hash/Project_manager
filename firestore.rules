rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Workspace Members Collection
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Categorization Tags Collection
    match /tags/{tagId} {
      allow read, write: if true;
    }

    // Test Connection Path
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
